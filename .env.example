# =============================================================
# MiroFish-Offline Configuration
# =============================================================
# Text generation uses OpenAI; graph embeddings use local Ollama.
# Copy this file to .env and adjust values for your setup.
# =============================================================

# ===== LLM Configuration (OpenAI-compatible format) =====
LLM_API_KEY=your-openai-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-6.1-terra
LLM_REASONING_EFFORT=high

# ===== Neo4j Configuration =====
# For Docker: use service name "neo4j" instead of "localhost"
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mirofish

# ===== Embedding Configuration =====
# Uses Ollama's embedding endpoint
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434
# For Docker: EMBEDDING_BASE_URL=http://ollama:11434

# ===== OASIS / CAMEL-AI Configuration =====
# CAMEL-AI reads OPENAI_API_KEY and OPENAI_API_BASE_URL
# Uses the same OpenAI account and Responses API for agent tool calls.
OPENAI_API_KEY=your-openai-api-key
OPENAI_API_BASE_URL=https://api.openai.com/v1

# Optional: configure separate credentials for PersonaLab.
# PERSONA_LAB_API_KEY=your-openai-api-key
# PERSONA_LAB_ENV_FILE=/absolute/path/to/Persona_AICC_Simulator/.dev.vars
PERSONA_LAB_BASE_URL=https://api.openai.com/v1
PERSONA_LAB_MODEL=gpt-6.1-terra
PERSONA_LAB_REASONING_EFFORT=high

# ===== Docker-mode overrides =====
# Uncomment these when running ALL services inside Docker
# (backend container talks to neo4j/ollama containers by service name)
# NEO4J_URI=bolt://neo4j:7687
# EMBEDDING_BASE_URL=http://ollama:11434
